{
  "redirects": [
    {
      "source": "/calculator",
      "destination": "/calculator/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/calculator/",
      "destination": "/calculator/index.html"
    },
    {
      "source": "/((?!calculator/).*)",
      "destination": "/index.html"
    }
  ]
}
